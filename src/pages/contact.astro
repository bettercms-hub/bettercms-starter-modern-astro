---
import Base from "../layouts/Base.astro";
import { getForm, getSingleton } from "../lib/content";
import { bcmsField } from "../lib/bcms";
import { plain, rich, type Contact } from "../lib/cms";
import { seo } from "../lib/seo";
import ContactForm from "../components/ContactForm.astro";

const contact = getSingleton<Contact>("contact");
const form = getForm("Contact");
const pageSeo = seo({
  title: plain(contact?.heroTitle) || "Contact",
  metaDescription: plain(contact?.heroSubtitle),
  schema: { "@context": "https://schema.org", "@type": "ContactPage", name: plain(contact?.heroTitle) || "Contact" },
});
---
<Base seo={pageSeo}>
  <main class="section container">
    <div class="split">
      <div class="reveal">
        {contact?.eyebrow && <p class="eyebrow" {...bcmsField("eyebrow")} set:html={rich(contact.eyebrow)} />}
        <h1 {...bcmsField("heroTitle")} set:html={rich(contact?.heroTitle, "Get in touch")} />
        {contact?.heroSubtitle && <p class="lead" style="margin-top:1.25rem" {...bcmsField("heroSubtitle")} set:html={rich(contact.heroSubtitle)} />}
      </div>
      <div class="form-card reveal">
        {form ? <ContactForm form={form} /> : <p class="lead">Add a form named “Contact” in BetterCMS to enable this form.</p>}
      </div>
    </div>
  </main>
</Base>
