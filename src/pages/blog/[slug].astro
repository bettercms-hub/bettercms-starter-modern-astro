---
import Base from "../../layouts/Base.astro";
import { listEntries, getEntry } from "../../lib/content";
import { plain, refData, rich, type Author, type BlogPost } from "../../lib/cms";
import { bcmsField } from "../../lib/bcms";
import { seo, blogPostingSchema } from "../../lib/seo";

export function getStaticPaths() {
  return listEntries<BlogPost>("blog-post").map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const post = getEntry<BlogPost>("blog-post", slug!);
if (!post) throw new Error(`blog post not found: ${slug}`);

const f = post.data;
const author = refData<Author>(f.author);
const byline = [author ? `By ${author.name}${author.role ? `, ${author.role}` : ""}` : null, f.publishedDate].filter(Boolean).join(" · ");
const pageSeo = seo({ title: plain(f.title), metaDescription: plain(f.excerpt), schema: blogPostingSchema(f, author) });
---
<Base seo={pageSeo}>
  <main>
    <article class="article">
      <a class="back-link" href="/blog">← Back to journal</a>
      {f.tags?.[0] && <p class="kicker" style="color:var(--accent-strong);font-weight:600;margin-top:1.5rem">{f.tags[0]}</p>}
      <h1 {...bcmsField("blog-post.title")} style="margin-top:.5rem" set:html={rich(f.title)} />
      {byline && <p class="byline">{byline}</p>}
      {f.coverImage?.url && <img class="cover" src={f.coverImage.url} alt={f.coverImage.alt ?? ""} />}
      {f.body?.html && <div class="prose" {...bcmsField("blog-post.body", "richtext")} set:html={f.body.html} />}
    </article>
  </main>
</Base>
