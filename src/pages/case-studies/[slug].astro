---
import Base from "../../layouts/Base.astro";
import { listEntries, getEntry } from "../../lib/content";
import { items, type CaseStudy } from "../../lib/cms";
import { bcmsField } from "../../lib/bcms";
import { seo, caseStudySchema } from "../../lib/seo";

export function getStaticPaths() {
  return listEntries<CaseStudy>("case-study").map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const study = getEntry<CaseStudy>("case-study", slug!);
if (!study) throw new Error(`case study not found: ${slug}`);

const f = study.data;
const metrics = items(f.metrics);
const pageSeo = seo({ title: f.title, metaDescription: f.summary, schema: caseStudySchema(f) });
---
<Base seo={pageSeo}>
  <main>
    <article class="article">
      <a class="back-link" href="/case-studies">← Back to work</a>
      {f.client && <p class="kicker" style="color:var(--accent-strong);font-weight:600;margin-top:1.5rem">{f.client}</p>}
      <h1 {...bcmsField("case-study.title")} style="margin-top:.5rem">{f.title}</h1>
      {f.summary && <p class="lead" style="margin-top:1rem">{f.summary}</p>}
      {f.coverImage?.url && <img class="cover" src={f.coverImage.url} alt={f.coverImage.alt ?? ""} />}
      {metrics.length > 0 && (
        <div class="stats" style="margin-bottom:2rem" {...bcmsField("case-study.metrics", "array")}>
          {metrics.map((m) => <div class="stat"><div class="num">{m.value}</div><div class="lbl">{m.label}</div></div>)}
        </div>
      )}
      {f.body?.html && <div class="prose" {...bcmsField("case-study.body", "richtext")} set:html={f.body.html} />}
    </article>
  </main>
</Base>
