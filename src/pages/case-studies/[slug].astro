---
import Base from "../../layouts/Base.astro";
import { listEntries, getEntry } from "../../lib/content";
import { items, plain, rich, type CaseStudy } from "../../lib/cms";
import { bcmsField } from "../../lib/bcms";
import { seo, caseStudySchema } from "../../lib/seo";

export function getStaticPaths() {
  return listEntries<CaseStudy>("case-study").map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const study = getEntry<CaseStudy>("case-study", slug!);
if (!study) throw new Error(`case study not found: ${slug}`);

const f = study.data;
const metrics = items(f.metrics);
const pageSeo = seo({ title: plain(f.title), metaDescription: plain(f.summary), schema: caseStudySchema(f) });
---
<Base seo={pageSeo}>
  <main>
    <article class="article">
      <a class="back-link" href="/case-studies">← Back to work</a>
      {f.client && <p class="kicker" style="color:var(--accent-strong);font-weight:600;margin-top:1.5rem" {...bcmsField("client")}>{f.client}</p>}
      <h1 {...bcmsField("title")} style="margin-top:.5rem" set:html={rich(f.title)} />
      {f.summary && <p class="lead" style="margin-top:1rem" {...bcmsField("summary")} set:html={rich(f.summary)} />}
      {f.coverImage?.url && <img class="cover" src={f.coverImage.url} alt={f.coverImage.alt ?? ""} {...bcmsField("coverImage", "image")} />}
      {metrics.length > 0 && (
        <div class="stats" style="margin-bottom:2rem" {...bcmsField("metrics", "array")}>
          {metrics.map((m, i) => <div class="stat"><div class="num" {...bcmsField(`case-study.metrics[${i}].value`)}>{m.value}</div><div class="lbl" {...bcmsField(`case-study.metrics[${i}].label`)}>{m.label}</div></div>)}
        </div>
      )}
      {f.body?.html && <div class="prose" {...bcmsField("body", "richtext")} set:html={f.body.html} />}
    </article>
  </main>
</Base>
