---
import Base from "../../layouts/Base.astro";
import { listEntries } from "../../lib/content";
import type { CaseStudy } from "../../lib/cms";
import { seo } from "../../lib/seo";
import CaseCard from "../../components/CaseCard.astro";

const studies = listEntries<CaseStudy>("case-study");
const pageSeo = seo({ title: "Work", metaDescription: "Selected client work and the outcomes we shipped." });
---
<Base seo={pageSeo}>
  <main class="section container">
    <div class="section-head reveal"><p class="eyebrow">Selected work</p><h1>Outcomes we're proud of</h1></div>
    {studies.length ? (
      <div class="card-grid">{studies.map((s) => <CaseCard study={s} />)}</div>
    ) : (
      <p class="lead" style="margin-top:2rem">No case studies published yet.</p>
    )}
  </main>
</Base>
