---
import { bcmsField } from "../lib/bcms";
import type { Feature, RichText } from "../lib/cms";
interface Props { heading?: RichText; data: Feature[]; }
const { heading, data } = Astro.props;
---
{data.length > 0 && (
  <section class="section container">
    {heading?.html && (
      <div class="section-head reveal">
        <p class="eyebrow">What we do</p>
        <h2 {...bcmsField("featuresHeading", "richtext")} set:html={heading.html} />
      </div>
    )}
    <div class="bento" {...bcmsField("features", "array")}>
      {data.map((f, i) => (
        <article class="feature reveal">
          {f.icon && <div class="ic" aria-hidden {...bcmsField(`home.features[${i}].icon`)}>{f.icon}</div>}
          <h3 {...bcmsField(`home.features[${i}].title`)}>{f.title}</h3>
          {f.body && <p {...bcmsField(`home.features[${i}].body`)}>{f.body}</p>}
        </article>
      ))}
    </div>
  </section>
)}
