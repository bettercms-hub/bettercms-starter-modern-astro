---
import type { Testimonial } from "../lib/cms";
interface Props { data: Testimonial[]; }
const { data } = Astro.props;
---
{data.length > 0 && (
  <section class="section container">
    <div class="section-head reveal"><p class="eyebrow">In their words</p><h2>What partners say</h2></div>
    <div class="quotes">
      {data.map((t) => (
        <figure class="quote reveal">
          <blockquote>“{t.quote}”</blockquote>
          <figcaption class="who">
            {t.avatar?.url && <img src={t.avatar.url} alt={t.avatar.alt ?? t.authorName ?? ""} />}
            <span>
              {t.authorName && <span class="name">{t.authorName}</span>}
              {t.authorRole && <span class="role"> — {t.authorRole}</span>}
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}
