---
import type { CaseStudy } from "../lib/cms";
import type { Entry } from "../lib/content";
interface Props { study: Entry<CaseStudy>; }
const { study } = Astro.props;
const f = study.data;
---
<a class="card reveal" href={`/case-studies/${study.slug}`}>
  {f.coverImage?.url && <div class="thumb"><img src={f.coverImage.url} alt={f.coverImage.alt ?? ""} loading="lazy" /></div>}
  <div class="body">
    {f.client && <span class="kicker">{f.client}</span>}
    <h3>{f.title}</h3>
    {f.summary && <p>{f.summary}</p>}
  </div>
</a>
