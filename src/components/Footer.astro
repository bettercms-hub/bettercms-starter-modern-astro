---
import type { DeliveryForm } from "@bettercms-ai/sdk";
import { bcmsField } from "../lib/bcms";
import { items, type NavLink, type Site, type Social } from "../lib/cms";
import NewsletterForm from "./NewsletterForm.astro";
interface Props { site?: Site; newsletter?: DeliveryForm; }
const { site, newsletter } = Astro.props;
const nav: NavLink[] = items(site?.navLinks);
const socials: Social[] = items(site?.socials);
const brand = site?.brandName ?? "Studio";
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="/" class="brand">{brand}<span class="dot">.</span></a>
        {site?.footerTagline?.html && <p class="tagline" {...bcmsField("site.footerTagline", "richtext")} set:html={site.footerTagline.html} />}
        {socials.length > 0 && (
          <div class="socials">
            {socials.map((s) => <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>)}
          </div>
        )}
      </div>
      <div class="stack">
        {nav.length > 0 && (
          <nav class="socials" aria-label="Footer">{nav.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
        )}
        {newsletter && (
          <div>
            <p class="tagline" style="margin-top:0">The studio journal, occasionally.</p>
            <NewsletterForm form={newsletter} />
          </div>
        )}
      </div>
    </div>
    <div class="colophon">
      <span>© {brand}. Built with BetterCMS.</span>
      <span>Crafted with care.</span>
    </div>
  </div>
</footer>
