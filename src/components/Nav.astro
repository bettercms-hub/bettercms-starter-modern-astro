---
import { items, type NavLink, type Site } from "../lib/cms";
import { getProjectId, searchPathMap } from "../lib/content";
interface Props { site?: Site; }
const { site } = Astro.props;
const links: NavLink[] = items(site?.navLinks);
const config = {
  project: getProjectId(),
  apiUrl: import.meta.env.PUBLIC_BCMS_API_URL ?? "https://api.bettercms.ai",
  pathMap: searchPathMap(),
};
---
<header class="header">
  <div class="container">
    <nav class="nav" id="site-nav">
      <a href="/" class="brand">{site?.brandName ?? "Studio"}<span class="dot">.</span></a>
      <div class="nav-links" id="nav-links">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
      <div class="nav-right">
        <button class="icon-btn" data-search-open aria-label="Search">
          <span aria-hidden="true">⌕</span><span class="label-full">Search</span><kbd class="kbd-hint">⌘K</kbd>
        </button>
        <button class="icon-btn nav-toggle" data-menu-toggle aria-label="Menu">Menu</button>
      </div>
    </nav>
  </div>
</header>

<div class="search-overlay" id="search-overlay" role="dialog" aria-modal="true" aria-label="Search" hidden>
  <div class="search-panel">
    <div class="search-input-row">
      <span aria-hidden="true">⌕</span>
      <input id="search-input" type="search" placeholder="Search articles, work, pages…" aria-label="Search query" />
      <button class="icon-btn" data-search-close aria-label="Close">Esc</button>
    </div>
    <div class="search-results" id="search-results"><p class="search-empty">Type at least two characters to search.</p></div>
  </div>
</div>

<script type="application/json" id="bcms-search-config" set:html={JSON.stringify(config)} is:inline />

<script>import "../scripts/ui";</script>
